// Cloudflare Workers config: serves the static rankings site in ./docs
// (the same directory GitHub Pages deploys) as an assets-only Worker.
// Deployed by Cloudflare's Workers Builds Git integration, which runs
// `npx wrangler deploy` on pushes to main.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "1500",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "ai": {
    "binding": "AI"
  }
}

// Cloudflare Workers config: serves the static rankings site in ./docs
// (the same directory GitHub Pages deploys) as an assets-only Worker.
// Deployed by Cloudflare's Workers Builds Git integration, which runs
// `npx wrangler deploy` on pushes to main.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "1500",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankings",
      "database_id": "eccac776-db1d-494c-afc8-17d41b57346f"
    }
  ],
  // Ingest the nightly rankings into D1 after the data workflow finishes
  // (it runs 05:30 UTC Tue-Sat; ingest is also triggered lazily on demand).
  "triggers": {
    "crons": ["30 7 * * 2-6"]
  }
}
